{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/remote.sh *)",
      "Bash(scripts/sync.sh push)",
      "Bash(scripts/sync.sh pull *)",
      "Bash(scripts/sync.sh pull)",
      "Bash(scripts/worker.sh status)",
      "Bash(scripts/worker.sh start)",
      "Bash(.venv-analysis/bin/python .claude/skills/report-results/scripts/*)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(du -sh *)"
    ],
    "ask": [
      "Bash(scripts/sync.sh put *)",
      "Bash(scripts/worker.sh stop)",
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(hf download *)",
      "Bash(huggingface-cli download *)",
      "Bash(rm *)",
      "Bash(pip install *)",
      "Bash(uv pip install *)"
    ],
    "deny": [
      "Bash(*submit_job.sh*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(sftp *)",
      "Bash(kubectl *)",
      "Bash(kubesh *)",
      "Bash(launch.sh *)",
      "Bash(launch-*)",
      "Bash(/opt/launch-sh/*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Edit(/scripts/_common.sh)",
      "Edit(/scripts/remote.sh)",
      "Edit(/scripts/sync.sh)",
      "Edit(/scripts/worker.sh)",
      "Edit(/scripts/submit_job.sh)",
      "Edit(/scripts/dsmlp.conf)",
      "Edit(/.claude/settings.json)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(//mnt/c/Users/**/.ssh/**)",
      "Read(//mnt/c/Users/**/.kube/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.git-credentials)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
